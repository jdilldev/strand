{
  "expo": {
    "name": "strand",
    "slug": "strand",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "strand",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jdilldev.strand",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jdilldev.strand"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            {
              "path": "./assets/fonts/SourceSans3-Black.ttf",
              "weight": "900",
              "style": "black"
            },
            {
              "path": "./assets/fonts/SourceSans3-ExtraBold.ttf",
              "weight": "800",
              "style": "heavy"
            },
            {
              "path": "./assets/fonts/SourceSans3-Bold.ttf",
              "weight": "700",
              "style": "bold"
            },
            {
              "path": "./assets/fonts/SourceSans3-SemiBold.ttf",
              "weight": "600",
              "style": "semibold"
            },
            {
              "path": "./assets/fonts/SourceSans3-Medium.ttf",
              "weight": "500",
              "style": "medium"
            },
            {
              "path": "./assets/fonts/SourceSans3-Regular.ttf",
              "weight": "400",
              "style": "normal"
            },
            {
              "path": "./assets/fonts/SourceSans3-Light.ttf",
              "weight": "300",
              "style": "light"
            },
            {
              "path": "./assets/fonts/SourceSans3-ExtraLight.ttf",
              "weight": "200",
              "style": "extralight"
            },
            {
              "path": "./assets/fonts/ArchivoNarrow-Bold.ttf",
              "weight": "700",
              "style": "bold"
            },
            {
              "path": "./assets/fonts/ArchivoNarrow-SemiBold.ttf",
              "weight": "600",
              "style": "semibold"
            },
            {
              "path": "./assets/fonts/ArchivoNarrow-Medium.ttf",
              "weight": "500",
              "style": "medium"
            },
            {
              "path": "./assets/fonts/ArchivoNarrow-Regular.ttf",
              "weight": "400",
              "style": "normal"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5f8bf67-2be6-4a60-ad08-3aed7fdc4572"
      }
    },
    "owner": "jdilldev"
  }
}
